# =============================================================================
#  Docker Compose variables (read automatically from ./.env by `docker compose`)
#  Copy to .env:   cp .env.example .env
#  For local development without Docker, use server/.env and client/.env instead.
# =============================================================================

# REQUIRED — secret used to sign JWTs. Generate with:  openssl rand -hex 32
JWT_SECRET=

# Admin account created by:  docker compose exec app npm run seed
ADMIN_NAME=Portal Admin
ADMIN_EMAIL=admin@isl.local
ADMIN_PASSWORD=change-me-Admin@123

# Public URL the browser uses to open the app (CORS origin). Change when serving
# behind a domain, e.g. https://signbridge.example.com (HTTPS is required for
# webcam access on anything other than localhost).
CLIENT_ORIGIN=http://localhost:5000
