# =============================================================================
#  SignBridge web client — environment variables
#  Copy to client/.env (or .env.local):   cp client/.env.example client/.env
#  VITE_* values are embedded in the public JS bundle — never put secrets here.
# =============================================================================

# Base URL of the API, without a trailing slash and without /api.
# Leave empty to use the same origin (Vite proxy in dev, Express in production).
# Set only when the API is deployed on a different domain, e.g. https://api.example.com
# (that domain must then be listed in the server's CLIENT_ORIGIN).
VITE_API_URL=

# Optional: custom URL for MediaPipe's hand_landmarker.task model.
# Default: /models/hand_landmarker.task (downloaded by scripts/prepare-mediapipe.mjs),
# falling back to Google's hosted copy.
VITE_HAND_MODEL_URL=

# ---- Development only -------------------------------------------------------
# Where the Vite dev server proxies /api and /uploads. Must match the server's PORT.
VITE_DEV_API=http://localhost:5050
