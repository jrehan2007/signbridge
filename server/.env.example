# =============================================================================
#  SignBridge API — environment variables
#  Copy to server/.env and adjust:   cp server/.env.example server/.env
#  Never commit server/.env (it is already in .gitignore).
# =============================================================================

# ---- Server -----------------------------------------------------------------
# development | production | test
#   production → requires JWT_SECRET, serves client/dist, enables caching
NODE_ENV=development

# Port the API listens on. The Vite dev proxy (client/vite.config.js) targets
# http://localhost:5050 by default — keep them in sync (see VITE_DEV_API).
PORT=5050

# Allowed browser origin(s) for CORS. Comma-separate multiple origins, no
# trailing slash. In production this is the public URL of the web app,
# e.g. https://signbridge.example.com
CLIENT_ORIGIN=http://localhost:5173

# ---- MongoDB ----------------------------------------------------------------
# Local:  mongodb://127.0.0.1:27017/isl_translator
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/isl_translator?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/isl_translator

# ---- Authentication ---------------------------------------------------------
# Secret used to sign JWTs. REQUIRED when NODE_ENV=production.
# Generate one with:  openssl rand -hex 32
JWT_SECRET=replace-with-output-of-openssl-rand-hex-32

# Token lifetime (vercel/ms format): 15m, 12h, 7d, 30d …
JWT_EXPIRES_IN=7d

# ---- Seed admin account -----------------------------------------------------
# Used only by `npm run seed`, which creates this admin if the email does not
# exist yet. Change the password before seeding any shared environment.
ADMIN_NAME=Portal Admin
ADMIN_EMAIL=admin@isl.local
ADMIN_PASSWORD=Admin@123
